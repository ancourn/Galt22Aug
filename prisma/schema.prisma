// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// AI Co-Pilot Memory
model AIConversation {
  id        String   @id @default(cuid())
  sessionId String
  role      String   // "user" or "assistant"
  content   String
  metadata  Json?
  createdAt DateTime @default(now())
  
  @@index([sessionId])
}

// Global Search Index
model SearchDocument {
  id          String   @id @default(cuid())
  moduleId    String   // "projects", "care", "wiki", "chat", "forms", "notes"
  title       String
  content     String
  url         String
  metadata    Json?
  indexedAt   DateTime @default(now())
  
  @@index([moduleId])
  @@index([title])
}

// Oxlas Flow Automations
model Automation {
  id          String   @id @default(cuid())
  name        String
  description String?
  enabled     Boolean  @default(true)
  trigger     Json    // { type: "formbricks_score", condition: { score: { lt: 3 } } }
  actions     Json    // [{ type: "create_zammad_ticket", ... }, { type: "notify_chat", ... }]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([enabled])
}

// Automation Execution History
model AutomationExecution {
  id           String   @id @default(cuid())
  automationId String
  triggerData  Json?
  actionResults Json?
  status       String   // "success", "failed", "running"
  error        String?
  executedAt   DateTime @default(now())
  
  @@index([automationId])
  @@index([status])
}

// Knowledge Graph (Oxlas Brain)
model KnowledgeNode {
  id          String   @id @default(cuid())
  moduleId    String   // "projects", "care", "wiki", "chat", "forms", "notes"
  title       String
  type        String   // "project", "ticket", "document", "message", "form", "note"
  content     String?
  url         String
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([moduleId])
  @@index([type])
}

model KnowledgeEdge {
  id          String   @id @default(cuid())
  fromNodeId  String
  toNodeId    String
  relation    String   // "mentions", "related_to", "depends_on", "references"
  weight      Float    @default(1.0)
  metadata    Json?
  createdAt   DateTime @default(now())
  
  @@index([fromNodeId])
  @@index([toNodeId])
  @@index([relation])
}

// User Management
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  avatar        String?
  role          String   @default("user") // "user", "admin"
  preferences   Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // Relations
  projects      Project[]
  notes         Note[]
  mails         Mail[]
  ownedTeams    Team[]      @relation("TeamOwner")
  teamMemberships TeamMember[]
  assignedTasks Task[]     @relation("TaskAssignee")
  reportedTasks Task[]     @relation("TaskReporter")
  taskComments  TaskComment[]
  timeEntries   TimeEntry[]
  dashboardWidgets DashboardWidget[]
  reports       Report[]
  activities    UserActivity[] @relation("UserActivities")
  performanceMetrics PerformanceMetric[]
  documents     Document[]
  
  @@index([role])
}

// Project Management
model Project {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String   @default("active") // "active", "completed", "archived"
  priority    String   @default("medium") // "low", "medium", "high"
  userId      String
  teamId      String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  team        Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  tasks       Task[]
  performanceMetrics PerformanceMetric[]
  documents   Document[]
  
  @@index([userId])
  @@index([teamId])
  @@index([status])
}

// Note Management
model Note {
  id          String   @id @default(cuid())
  title       String
  content     String?
  userId      String
  tags        String?  // JSON string array of tags
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
}

// Mail/Email Management
model Mail {
  id          String   @id @default(cuid())
  userId      String
  from        String   // Sender email address
  fromName    String?  // Sender name
  to          String   // Recipient email address (comma-separated for multiple)
  toNames     String?  // Recipient names (JSON array)
  cc          String?  // CC recipients (comma-separated)
  bcc         String?  // BCC recipients (comma-separated)
  subject     String
  content     String   // HTML content
  textContent String?  // Plain text content
  status      String   @default("inbox") // "inbox", "sent", "draft", "trash", "archived"
  folder      String   @default("inbox") // "inbox", "sent", "draft", "trash", "archived", "starred"
  read        Boolean  @default(false)
  starred     Boolean  @default(false)
  important   Boolean  @default(false)
  hasAttachments Boolean @default(false)
  attachments Json?    // Array of attachment objects
  replyTo     String?  // Email address to reply to
  replyToName String?  // Name to reply to
  inReplyTo   String?  // Message ID this email is replying to
  messageId   String?  // Unique message ID
  threadId    String?  // Thread ID for grouping conversations
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mailAttachments MailAttachment[]
  
  @@index([userId])
  @@index([status])
  @@index([folder])
  @@index([read])
  @@index([starred])
  @@index([createdAt])
}

// Mail Attachments
model MailAttachment {
  id          String   @id @default(cuid())
  mailId      String
  filename    String
  originalName String
  fileSize    Int
  mimeType    String
  filePath    String
  createdAt   DateTime @default(now())
  
  // Relations
  mail        Mail     @relation(fields: [mailId], references: [id], onDelete: Cascade)
  
  @@index([mailId])
}

// Team Management
model Team {
  id          String   @id @default(cuid())
  name        String
  description String?
  avatar      String?
  ownerId     String
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  owner       User     @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     TeamMember[]
  projects    Project[]
  tasks       Task[]
  performanceMetrics PerformanceMetric[]
  documents   Document[]
  
  @@index([ownerId])
}

// Team Members
model TeamMember {
  id          String   @id @default(cuid())
  teamId      String
  userId      String
  role        String   @default("member") // "owner", "admin", "member", "viewer"
  joinedAt    DateTime @default(now())
  metadata    Json?
  
  // Relations
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
}

// Task Management
model Task {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String   @default("todo") // "todo", "in_progress", "review", "done"
  priority    String   @default("medium") // "low", "medium", "high", "urgent"
  type        String   @default("task") // "task", "bug", "feature", "epic"
  projectId   String?
  teamId      String?
  assigneeId  String?
  reporterId  String
  dueDate     DateTime?
  startDate   DateTime?
  completedAt DateTime?
  estimatedHours Int?
  actualHours    Int?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  team        Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  assignee    User?    @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporter    User     @relation("TaskReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  comments    TaskComment[]
  timeEntries TimeEntry[]
  attachments TaskAttachment[]
  performanceMetrics PerformanceMetric[]
  documents   Document[]
  
  @@index([projectId])
  @@index([teamId])
  @@index([assigneeId])
  @@index([reporterId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
}

// Task Comments
model TaskComment {
  id          String   @id @default(cuid())
  taskId      String
  userId      String
  content     String
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([taskId])
  @@index([userId])
}

// Time Tracking
model TimeEntry {
  id          String   @id @default(cuid())
  taskId      String
  userId      String
  description String?
  hours       Float
  date        DateTime
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([taskId])
  @@index([userId])
  @@index([date])
}

// Task Attachments
model TaskAttachment {
  id          String   @id @default(cuid())
  taskId      String
  filename    String
  originalName String
  fileSize    Int
  mimeType    String
  filePath    String
  createdAt   DateTime @default(now())
  
  // Relations
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  
  @@index([taskId])
}

// Analytics and Metrics
model AnalyticsMetric {
  id          String   @id @default(cuid())
  type        String   // "task_completion", "team_productivity", "project_progress", "user_activity"
  entityId    String   // ID of the related entity (task, team, project, user)
  entityType  String   // "task", "team", "project", "user"
  metricName  String   // Specific metric name
  value       Float    // Metric value
  unit        String?  // Unit of measurement (hours, count, percentage, etc.)
  period      String   // "daily", "weekly", "monthly", "yearly"
  date        DateTime // Date for this metric
  metadata    Json?    // Additional metric data
  createdAt   DateTime @default(now())
  
  @@index([type, entityType])
  @@index([entityId, entityType])
  @@index([period, date])
  @@index([metricName])
}

model DashboardWidget {
  id          String   @id @default(cuid())
  userId      String
  name        String
  type        String   // "chart", "metric", "table", "list"
  widgetType  String   // "line_chart", "bar_chart", "pie_chart", "metric_card", "data_table", "activity_list"
  title       String
  description String?
  config      Json     // Widget configuration (filters, chart settings, etc.)
  position    Int      // Widget position on dashboard
  isVisible   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([type, widgetType])
}

model Report {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  type        String   // "team_performance", "project_summary", "productivity", "custom"
  config      Json     // Report configuration (filters, metrics, time range)
  schedule    String?  // "daily", "weekly", "monthly", "quarterly"
  format      String   @default("pdf") // "pdf", "csv", "json"
  recipients  Json?    // List of email recipients
  isActive    Boolean  @default(true)
  lastRunAt   DateTime?
  nextRunAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  executions  ReportExecution[]
  
  @@index([userId])
  @@index([type])
  @@index([schedule])
  @@index([isActive])
}

model ReportExecution {
  id          String   @id @default(cuid())
  reportId    String
  status      String   // "pending", "running", "completed", "failed"
  filePath    String?  // Path to generated report file
  fileSize    Int?     // Size of generated file
  error       String?  // Error message if failed
  executedAt  DateTime @default(now())
  completedAt DateTime?
  metadata    Json?    // Execution metadata
  
  // Relations
  report      Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  
  @@index([reportId])
  @@index([status])
  @@index([executedAt])
}

// User Activity Tracking
model UserActivity {
  id          String   @id @default(cuid())
  userId      String
  action      String   // "login", "logout", "create_task", "update_task", "complete_task", "create_team", etc.
  entityType  String?  // "task", "team", "project", "note", "mail", etc.
  entityId    String?  // ID of the affected entity
  metadata    Json?    // Additional activity data
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  
  // Relations
  user        User     @relation("UserActivities", fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

// Performance Metrics
model PerformanceMetric {
  id          String   @id @default(cuid())
  userId      String?
  teamId      String?
  projectId   String?
  taskId      String?
  metricType  String   // "response_time", "completion_rate", "productivity_score", "efficiency"
  value       Float
  unit        String?  // "ms", "percentage", "score", "hours"
  context     Json?    // Additional context for the metric
  period      String   @default("daily") // "hourly", "daily", "weekly", "monthly"
  timestamp   DateTime @default(now())
  
  // Relations
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  team        Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task        Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  
  @@index([userId])
  @@index([teamId])
  @@index([projectId])
  @@index([taskId])
  @@index([metricType, period])
  @@index([timestamp])
}

// Legacy models (for backward compatibility)
model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Document Management System
model Document {
  id            String   @id @default(cuid())
  title         String
  description   String?
  fileName      String
  originalName  String
  fileSize      Int
  mimeType      String
  filePath      String
  status        String   @default("uploading") // "uploading", "processing", "ready", "failed", "archived"
  visibility    String   @default("private") // "private", "team", "public"
  userId        String
  teamId        String?
  projectId     String?
  taskId        String?
  tags          String?  // JSON string array of tags
  metadata      Json?    // Document metadata extracted by AI
  extractedText String?  // Text extracted from document
  embeddings    Json?    // Vector embeddings for semantic search
  processingLog Json?    // Processing log and errors
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // Relations
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  team          Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  project       Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task          Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  analyses      DocumentAnalysis[]
  versions      DocumentVersion[]
  shares        DocumentShare[]
  
  @@index([userId])
  @@index([teamId])
  @@index([projectId])
  @@index([taskId])
  @@index([status])
  @@index([visibility])
  @@index([createdAt])
  @@index([tags])
}

model DocumentAnalysis {
  id          String   @id @default(cuid())
  documentId  String
  type        String   // "entity_extraction", "sentiment_analysis", "topic_classification", "summary", "key_phrases", "ocr"
  analysis    Json     // Analysis results
  confidence  Float?   // Confidence score for the analysis
  processingTime Int?  // Time taken for analysis in milliseconds
  metadata    Json?
  createdAt   DateTime @default(now())
  
  // Relations
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  
  @@index([documentId])
  @@index([type])
  @@index([createdAt])
}

model DocumentVersion {
  id          String   @id @default(cuid())
  documentId  String
  version     Int
  fileName    String
  originalName String
  fileSize    Int
  mimeType    String
  filePath    String
  changeLog   String?  // Description of changes
  createdBy   String   // User ID who created this version
  createdAt   DateTime @default(now())
  
  // Relations
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  
  @@index([documentId])
  @@index([version])
  @@unique([documentId, version])
}

model DocumentShare {
  id          String   @id @default(cuid())
  documentId  String
  sharedWith  String   // User ID or email
  sharedBy    String   // User ID who shared
  permission  String   @default("view") // "view", "edit", "download"
  expiresAt   DateTime?
  message     String?  // Optional message when sharing
  createdAt   DateTime @default(now())
  accessedAt  DateTime?
  
  // Relations
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  
  @@index([documentId])
  @@index([sharedWith])
  @@index([permission])
  @@index([expiresAt])
}